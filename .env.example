# 复制为 .env 并填入你的 Key（.env 不会提交到 git）

# ── 阿里云百炼（推荐：一个 Key 同时用于识别和翻译）────────────────
# 控制台：https://bailian.console.aliyun.com  → API-KEY
# 注意：识别模型需要在控制台里单独开通
DASHSCOPE_API_KEY=
# 业务空间专属 Key（sk-ws- 开头）要配合专属地址使用：
# TINGYI_STT_BASE_URL=wss://<空间>.cn-beijing.maas.aliyuncs.com/api-ws/v1/inference
# TINGYI_LLM_BASE_URL=https://<空间>.cn-beijing.maas.aliyuncs.com/compatible-mode/v1

# ── 语音识别 ─────────────────────────────────────────────
# aliyun（默认，流式，边说边出字）| openai（分段，OpenAI 兼容 /audio/transcriptions）
TINGYI_STT=aliyun
# 流式默认模型 qwen-audio-3.1-asr-flash-streaming；也可以用 fun-asr-realtime、paraformer-realtime-v2
# TINGYI_STT_MODEL=
# 识别语言提示（默认 zh+en 混合）
# TINGYI_STT_LANGUAGE=zh
# 额外识别参数（JSON，合并进 run-task 的 parameters）
# TINGYI_STT_PARAMS={"max_sentence_silence": 600}

# 分段模式示例：硅基流动 SenseVoice（免费）
# TINGYI_STT=openai
# SILICONFLOW_API_KEY=
# TINGYI_STT_BASE_URL=https://api.siliconflow.cn/v1
# TINGYI_STT_MODEL=FunAudioLLM/SenseVoiceSmall

# ── 翻译（OpenAI 兼容）──────────────────────────────────────
# 默认：百炼 compatible-mode + qwen-flash，Key 复用 DASHSCOPE_API_KEY
# TINGYI_LLM_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
# TINGYI_LLM_MODEL=qwen-flash
# TINGYI_LLM_KEY=
# 额外请求参数（JSON），例如思考型模型关闭思考：{"enable_thinking": false}
# TINGYI_LLM_EXTRA=

# 目标语言；原文已经是目标语言时翻成备用语言
TINGYI_TARGET=zh
TINGYI_FALLBACK=en
